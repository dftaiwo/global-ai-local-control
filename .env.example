# Offline mode is the default. AWS is not required to finish the lab.
AGENT_MODE=offline
# Live mode only: name the AWS CLI profile explicitly. Left blank, live mode refuses to start.
# Delete the line to use this machine's default credentials (which may be a different account).
AWS_PROFILE=
# EU geographic inference; model inference occurs in AWS EU destination Regions, NOT Nigeria.
# Run `python -m lab.cli aws-check` to list the exact destination Regions for your account.
AWS_REGION=eu-west-1
BEDROCK_MODEL_ID=eu.amazon.nova-2-lite-v1:0
# Set an absolute path if you prefer. By default the DB is stored under ./data/.
LOCAL_DB_PATH=
